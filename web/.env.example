# Mode de la couche adapter : « mock » (jeu de démonstration en mémoire) ou
# « http » (API Quarkus de ce dépôt).
#
# Les deux servent les mêmes données : la migration V2 du backend reprend le jeu
# de démonstration du frontend. Basculer de l'un à l'autre ne change donc rien à
# l'écran — c'est voulu, et c'est ce qui permet de vérifier le branchement.
VITE_API_MODE=http

# Base des appels HTTP lorsque VITE_API_MODE=http.
# En développement, le proxy Vite redirige /api vers le backend.
VITE_API_BASE_URL=/api

# Cible du proxy Vite. Par défaut http://localhost:8081 — le port 8080 étant
# souvent pris par Apache sur les postes de développement.
# VITE_API_TARGET=http://localhost:8081
